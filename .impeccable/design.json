  "components": [
    { "name": "button", "snippet": ".civic-button{background:var(--primary);color:var(--primary-foreground);border:1px solid transparent;border-radius:var(--radius-md);min-height:2rem;padding:.5rem .625rem;font:500 .875rem var(--font-geist-sans);transition:all .15s ease}.civic-button:hover{background:color-mix(in srgb,var(--primary),var(--foreground) 12%)}.civic-button:focus-visible{outline:3px solid var(--ring);outline-offset:3px}.civic-button:disabled{pointer-events:none;opacity:.5}" },
    { "name": "button-outline", "snippet": ".civic-button-outline{background:var(--background);color:var(--foreground);border:1px solid var(--border);border-radius:var(--radius-md);padding:.5rem .625rem}.civic-button-outline:hover{background:var(--muted)}.civic-button-outline:focus-visible{outline:3px solid var(--ring);outline-offset:3px}" },
    { "name": "input", "snippet": ".civic-input{width:100%;height:2rem;border:1px solid var(--input);border-radius:var(--radius-lg);background:var(--card);color:var(--foreground);padding:.25rem .625rem;outline:none}.civic-input::placeholder{color:var(--muted-foreground)}.civic-input:focus-visible{border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 20%,transparent)}.civic-input:disabled{opacity:.5}" },
    { "name": "card", "snippet": ".civic-card{display:flex;flex-direction:column;gap:var(--card-spacing,1rem);border-radius:var(--radius-sm);background:var(--card);color:var(--card-foreground);padding:var(--card-spacing,1rem);box-shadow:0 0 0 1px color-mix(in srgb,var(--foreground) 10%,transparent)}" },
    { "name": "status", "snippet": ".civic-status{display:inline-flex;align-items:center;border-radius:var(--radius-sm);padding:.125rem .5rem;font-size:.75rem;font-weight:500}.civic-status--success{background:var(--success-soft);color:var(--success)}.civic-status--warning{background:var(--warning-soft);color:var(--warning-foreground)}.civic-status--error{background:var(--destructive-soft);color:var(--destructive)}" },
    { "name": "public-navigation", "snippet": ".civic-public-nav{position:sticky;top:0;z-index:50;border-bottom:1px solid var(--line);background:var(--card)}.civic-public-nav a{color:var(--muted-text);padding:.625rem .75rem}.civic-public-nav a:hover{background:var(--muted);color:var(--primary)}.civic-public-nav button:focus-visible,.civic-public-nav a:focus-visible{outline:3px solid var(--ring);outline-offset:3px}" },
    { "name": "evaluator-sidebar", "snippet": ".civic-sidebar{position:sticky;top:0;width:248px;min-width:248px;height:100vh;border-right:1px solid var(--line);background:var(--card)}.civic-sidebar a{display:flex;gap:.75rem;padding:.625rem .75rem;color:var(--muted-text);border-radius:var(--radius-sm)}.civic-sidebar a[aria-current=page]{background:var(--secondary);color:var(--primary)}" },
    { "name": "theme-toggle", "snippet": ".civic-theme-toggle{display:inline-flex;width:2.25rem;height:2.25rem;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--card);color:var(--muted-text)}.civic-theme-toggle:hover{background:var(--muted);color:var(--foreground)}.civic-theme-toggle:focus-visible{outline:3px solid var(--ring);outline-offset:3px}" }
  ],
  "narrative": {
    "overview": "**Civic Signal** is a precise and efficient government verification interface. Its **Government Navy** character uses calm surfaces, clear state communication, and restrained DMW blue, crimson, and gold accents. **Structural elevation** establishes hierarchy through borders and tonal layering; shadows stay quiet. The component philosophy is **Precise surfaces**: every surface should expose the current state, next action, and reason without ceremony.",
    "colors": "Use semantic roles for page fields, surfaces, text, boundaries, primary actions, supporting surfaces, statuses, and focus. DMW blue is the primary signal, crimson is reserved for destructive or urgent decisions, and gold is a restrained accent and focus signal. Do not introduce gradients or distribute accent colors evenly.",
    "typography": "Geist is the body voice, Geist Mono is reserved for machine-readable identifiers, and Georgia provides the display and editorial contrast. Keep language direct and operational.",
    "elevation": "Elevation is structural: borders and tonal layering establish structure; shadows stay quiet. Do not add floating decorative cards, dramatic shadows, or colored side borders as a universal pattern.",
    "components": "Components should make the current condition, available action, and consequence obvious. Navigation, controls, status communication, focus, motion, and responsive behavior remain semantic and keyboard-operable.",
    "dosAndDonts": "Use semantic tokens, visible focus, text status, familiar controls, reduced motion, and both themes. Do not add gradients, huge radii, decorative cards, casual language, hover-only behavior, raw public surface colors, analytics, route changes, or altered form semantics."
  }
}
